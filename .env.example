# Names only — never commit real values. Copy to .env (git-ignored) if needed.
ODOO_URL=
ODOO_DB=
ODOO_LOGIN=
# Optional: only when NOT using the platform's credential injection.
ODOO_API_KEY=
# Optional tuning
ODOO_ACCOUNTANT_RUNTIME_DIR=
ODOO_ACCOUNTANT_APPROVERS=cli:*,claude_code:*
ODOO_ACCOUNTANT_ALLOW_DESTRUCTIVE=0
ODOO_ACCOUNTANT_OUTPUT_DIR=
# Extra directories (os.pathsep-separated) from which source_path may be read
ODOO_ACCOUNTANT_INPUT_DIRS=
# Telegram (future; not used yet)
TELEGRAM_ALLOWED_USER_IDS=
